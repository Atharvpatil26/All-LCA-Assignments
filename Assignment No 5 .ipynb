   "source": [
    "# Program to check whether a string contains only\n",
    "# alphabets (A-Z, a-z) and digits (0-9)\n",
    "\n",
    "string = input(\"Enter a string: \")\n",
    "\n",
    "if string.isalnum():\n",
    "    print(\"The string contains only letters and numbers.\")\n",
    "else:\n",
    "    print(\"The string contains other characters.\")"
   ]
